# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files（真实凭据一律不入库，仅保留 .env.example 模板）
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 判题测试数据（运行时产物，体积大，不入库）
/judge-data/
/judge/data/

# 打包/部署临时产物
*.zip
*.tar
*.tar.gz

# 编辑器与系统
.vscode/
.idea/
Thumbs.db

# 临时自测脚本
_*.js
