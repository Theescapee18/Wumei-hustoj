# ===== 数据库（PostgreSQL，推荐） =====
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=change_me
DB_NAME=jol

# ===== 数据库（MySQL，兼容旧版 HUSTOJ） =====
# DB_TYPE=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASS=change_me
# DB_NAME=jol

# ===== 鉴权 =====
# 生产环境必须替换为随机长字符串，可用：openssl rand -base64 32
JWT_SECRET=change_me_to_a_long_random_string

# ===== 判题与文件路径 =====
# 题目测试数据根目录，结构为 <OJ_DATA>/<题目ID>/*.in|*.out
OJ_DATA=/home/judge/data
UPLOAD_PATH=/var/www/html/upload

# ===== 站点 =====
# 站点名称，构建时内联进前端，Docker 构建请通过 build-arg 传入
NEXT_PUBLIC_OJ_NAME=社团OJ
