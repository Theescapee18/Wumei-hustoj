# 统一换行符：仓库内一律 LF，避免 Windows 开发 + Linux 部署时脚本执行失败
* text=auto eol=lf

# Windows 专用脚本保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件不做换行符转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.woff binary
*.woff2 binary
*.zip binary

# 锁文件在 PR diff 中折叠显示
package-lock.json linguist-generated=true -diff
